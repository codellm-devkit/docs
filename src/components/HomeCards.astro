  title: string;
  description: string;
  href: string;
  icon: keyof typeof ICONS;
};

// Everything not surfaced as a hero button (Quickstart / What is CLDK? / GitHub).
const cards: Card[] = [
  {
    title: "Examples",
    description: "Runnable Python and Java snippets pulled from SDK tests.",
    href: "/examples/",
    icon: "workflow",
  },
  {
    title: "cocoa",
    description: "Claude Code plugin for callers, reachability, and change impact.",
    href: "/cocoa/",
    icon: "chat",
  },
  {
    title: "API reference",
    description: "The CLDK factory, language APIs, and typed models.",
    href: "/reference/python-api/",
    icon: "manual",
  },
  {
    title: "Contributing",
    description: "Add a language backend or a new frontend SDK.",
    href: "/contributing/",
    icon: "developer",
  },
];

