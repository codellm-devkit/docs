---

<div class="cldk-cards">
  {
    cards.map((card) => {
      const icon = ICONS[card.icon];
      return (
        <a class="cldk-card" href={card.href}>
          <span class="cldk-card__icon" aria-hidden="true">
            <svg viewBox={icon.viewBox} fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              {icon.paths.map((d) => (
                <path d={d} fill-rule="evenodd" clip-rule="evenodd" />
              ))}
            </svg>
          </span>
          <span class="cldk-card__body">
            <span class="cldk-card__title">{card.title}</span>
            <span class="cldk-card__desc">{card.description}</span>
          </span>
        </a>
      );
    })
  }
</div>

<style>
  .cldk-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .cldk-card {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--cldk-border, var(--sl-color-hairline));
    border-radius: 0.4rem;
    background: var(--cldk-surface, var(--sl-color-bg));
    text-decoration: none;
    color: var(--sl-color-white);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .cldk-card:hover {
    border-color: var(--cldk-blue, var(--sl-color-accent));
    transform: translateY(-4px);
    box-shadow: 0 12px 28px -10px rgba(0, 0, 0, 0.5);
  }

  :global(:root[data-theme="light"]) .cldk-card:hover {
    box-shadow: 0 12px 28px -12px rgba(15, 98, 254, 0.3);
  }

  .cldk-card__icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.3rem;
    background: var(--sl-color-accent-low);
    color: var(--cldk-blue, var(--sl-color-accent));
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .cldk-card:hover .cldk-card__icon {
    background: var(--cldk-blue, var(--sl-color-accent));
    color: #ffffff;
  }

  .cldk-card__icon svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .cldk-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .cldk-card__title {
    font-weight: 600;
    font-size: var(--sl-text-lg);
    line-height: 1.2;
    color: var(--sl-color-white);
  }

  .cldk-card__desc {
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }
</style>
