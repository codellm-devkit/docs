---
/**
 * Header social icons, plus live GitHub counts for the Python SDK.
 *
 * Wraps Starlight's own SocialIcons so the configured links keep working, and
 * prepends watcher / star / fork counts for codellm-devkit/python-sdk.
 *
 * The counts are fetched once at build time, not in the browser: the header is
 * on every page, and three shields.io images per page load would cost three
 * third-party requests each time. A build-time fetch renders as inline SVG and
 * text instead, so it costs the reader nothing.
 *
 * The trade is staleness between deploys, which is the right trade here because
 * the site redeploys on every push. If GitHub is unreachable or rate-limits the
 * build, `stats` stays null and this renders only the social icons: a docs build
 * must never fail because a counter was unavailable.
 */
import Default from "@astrojs/starlight/components/SocialIcons.astro";

const REPO = "codellm-devkit/python-sdk";

type Stats = { watchers: number; stars: number; forks: number };

async function repoStats(): Promise<Stats | null> {
  try {
    const res = await fetch(`https://api.github.com/repos/${REPO}`, {
      headers: {
        Accept: "application/vnd.github+json",
        "User-Agent": "cldk-docs-build",
        // GITHUB_TOKEN lifts the 60/hour unauthenticated limit in CI. Optional:
        // one request per build stays well inside the anonymous budget locally.
        ...(process.env.GITHUB_TOKEN
          ? { Authorization: `Bearer ${process.env.GITHUB_TOKEN}` }
          : {}),
      },
      signal: AbortSignal.timeout(5000),
    });
    if (!res.ok) return null;
    const d = await res.json();
    if (typeof d?.stargazers_count !== "number") return null;
    return {
      // subscribers_count is what GitHub shows as "Watching"; watchers_count is
      // a legacy alias for the star count and would double-report stars.
      watchers: d.subscribers_count ?? 0,
      stars: d.stargazers_count,
      forks: d.forks_count ?? 0,
    };
  } catch {
    return null;
  }
}

const stats = await repoStats();

// Compact above 4 digits so the header never wraps: 12043 -> 12k
const fmt = (n: number) =>
  n >= 1000 ? `${(n / 1000).toFixed(n < 10000 ? 1 : 0)}k`.replace(".0k", "k") : String(n);

const ICONS = {
  watchers:
    "M8 2c1.981 0 3.671.992 4.933 2.078 1.27 1.091 2.187 2.345 2.637 3.023a1.62 1.62 0 0 1 0 1.798c-.45.678-1.367 1.932-2.637 3.023C11.67 13.008 9.981 14 8 14c-1.981 0-3.671-.992-4.933-2.078C1.797 10.83.88 9.576.43 8.898a1.62 1.62 0 0 1 0-1.798c.45-.677 1.367-1.931 2.637-3.022C4.33 2.992 6.019 2 8 2ZM1.679 7.932a.12.12 0 0 0 0 .136c.411.622 1.241 1.75 2.366 2.717C5.176 11.758 6.527 12.5 8 12.5s2.824-.742 3.955-1.715c1.124-.967 1.954-2.096 2.366-2.717a.12.12 0 0 0 0-.136c-.412-.621-1.242-1.75-2.366-2.717C10.824 4.242 9.473 3.5 8 3.5c-1.473 0-2.824.742-3.955 1.715-1.124.967-1.954 2.096-2.366 2.717ZM8 10a2 2 0 1 1-.001-3.999A2 2 0 0 1 8 10Z",
  stars:
    "M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z",
  forks:
    "M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z",
} as const;

const ORDER = [
  { key: "watchers", label: "watchers", href: `https://github.com/${REPO}/watchers` },
  { key: "stars", label: "stars", href: `https://github.com/${REPO}/stargazers` },
  { key: "forks", label: "forks", href: `https://github.com/${REPO}/forks` },
] as const;
---

{
  stats && (
    <div class="cldk-repostats" aria-label={`python-sdk on GitHub: ${stats.watchers} watchers, ${stats.stars} stars, ${stats.forks} forks`}>
      {ORDER.map(({ key, label, href }) => (
        <a
          class="cldk-repostat"
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          title={`${stats[key].toLocaleString("en-US")} ${label} on ${REPO}`}
        >
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d={ICONS[key]} />
          </svg>
          <span>{fmt(stats[key])}</span>
        </a>
      ))}
    </div>
  )
}

<Default {...Astro.props} />

<style>
  .cldk-repostats {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-inline-end: 0.35rem;
    padding-inline-end: 0.6rem;
    border-inline-end: 1px solid var(--cldk-border, var(--sl-color-hairline));
  }

  .cldk-repostat {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--sl-text-xs);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .cldk-repostat:hover {
    color: var(--cldk-blue, var(--sl-color-accent));
  }

  .cldk-repostat svg {
    width: 0.9rem;
    height: 0.9rem;
    flex: 0 0 auto;
  }

  /* The header is tight on phones; the social icons and the site title matter
     more than the counters, so drop them rather than let the bar wrap. */
  @media (max-width: 50rem) {
    .cldk-repostats {
      display: none;
    }
  }
</style>
